# Copy to `.env` and fill in. `.env` is gitignored; this example file is not.
#
# NOTE: nothing in this project loads `.env` automatically (there is no dotenv
# dependency). Export the values into your shell before running:
#
#     set -a; source .env; set +a
#
# ---------------------------------------------------------------------------
# Lulu Print API credentials  (only used by the optional `lulu-api` feature)
# ---------------------------------------------------------------------------
# Read by `lulu_prep::lulu_api::Credentials::from_env()`. These EXACT names are
# what the code looks for — see crates/lulu-prep/src/lulu_api.rs.
#
# Only ONE pair is read. There is currently no environment variable that
# selects sandbox vs production: the caller picks that in code by passing
# `Environment::Sandbox` or `Environment::Production`. So to switch
# environments, swap the values below (or keep two files and source the one
# you want).
#
# Get these from https://developers.lulu.com/ -> your API keys. Both the
# sandbox and production consoles issue their own key/secret pair.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# The API uses the OAuth client-credentials grant and derives the Basic auth
# header itself from the key and secret above, so a pre-base64-encoded
# "key:secret" value is NOT needed and is not read by anything.

# ---------------------------------------------------------------------------
# CLI configuration (all optional; flags override these, these override the
# config files, config files override built-in defaults)
# ---------------------------------------------------------------------------
# See `lulu-prep --print-config` to check what is actually in effect and where
# each value came from.

# center | scale-to-bleed | stretch-margins   (default: center)
# LULU_PREP_FIT_MODE=center

# Directory default output paths are written into (default: ".")
# LULU_PREP_OUTPUT_DIR=.

# Promote warnings to a non-zero exit code: 1/true/yes/on or 0/false/no/off
# LULU_PREP_STRICT=false

# Minimum gutter width to advise, in inches (default: 0.0)
# LULU_PREP_GUTTER_FLOOR_IN=0.0

# Disable colour. The standard NO_COLOR convention is honoured too (any
# non-empty value disables colour).
# LULU_PREP_NO_COLOR=1
